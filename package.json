{
  "name": "@notrealstudio/nr-chat-store",
  "version": "0.22.0",
  "description": "Neutral chat-session model + SessionStore contract + driver registry + storage drivers (nr-chat/pi/claude). Zero-dep core: model types, tree math, the driver contract. The home of message anatomy for storage and wire.",
  "keywords": [
    "chat",
    "session",
    "session-store",
    "conversation-tree",
    "branching",
    "swipes",
    "message",
    "part",
    "llm",
    "jsonl",
    "nr-chat",
    "mds",
    "claude",
    "zero-dependency"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nr-chat": {
      "types": "./dist/nr-chat/index.d.ts",
      "import": "./dist/nr-chat/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./assembly": {
      "types": "./dist/assembly/index.d.ts",
      "import": "./dist/assembly/index.js"
    },
    "./lore-files": {
      "types": "./dist/lore-files.d.ts",
      "import": "./dist/lore-files.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./node-fs": {
      "types": "./dist/fs/node.d.ts",
      "import": "./dist/fs/node.js"
    },
    "./lore": {
      "types": "./dist/lore.d.ts",
      "import": "./dist/lore.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@notrealstudio/nr-contracts": "file:../nr-contracts"
  },
  "peerDependencies": {
    "@notrealstudio/nr-chat": ">=0.1.3 <1",
    "@notrealstudio/nrd": ">=1.5.1 <2",
    "nunjucks": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "@notrealstudio/nr-chat": {
      "optional": true
    },
    "@notrealstudio/nrd": {
      "optional": true
    },
    "nunjucks": {
      "optional": true
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "devDependencies": {
    "@notrealstudio/nr-chat": "file:../nr-chat",
    "@types/node": "^24.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0",
    "@notrealstudio/nrd": "file:../nrd",
    "nunjucks": "^3.2.4",
    "@types/nunjucks": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
